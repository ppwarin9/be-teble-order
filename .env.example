# Copy to .env for local development. Never commit the real .env file.
#
# On Railway, set these under the service's Variables tab instead:
# - DATABASE_URL: don't type it manually — add a Postgres plugin to the
#   project, then reference it as ${{Postgres.DATABASE_URL}}.
# - PORT: leave unset. Railway injects its own PORT and the app already
#   reads process.env.PORT.
# - NODE_ENV: set to "production". Disables the /docs Swagger UI.
# - JWT_SECRET: generate a fresh random value for production, e.g.
#   `openssl rand -base64 32`. Never reuse the local dev value.
# - CORS_ORIGIN: set to the deployed frontend's exact origin(s), not "*".
# - LINE_CHANNEL_ID: the LIFF app's channel ID from the LINE Developers
#   console. Used to verify the LIFF ID token sent by customers on
#   POST /liff/table-sessions/join, so a customer's identity can't be
#   spoofed by a self-reported field.

DATABASE_URL="postgres://postgres:password@localhost:5432/table_order"
PORT="9999"
NODE_ENV="development"
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="*"
LINE_CHANNEL_ID="replace-with-your-line-liff-channel-id"
